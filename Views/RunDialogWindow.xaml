<Window x:Class="TempControl.Views.RunDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start Run Session"
        Width="460" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F2F5">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Save Folder -->
        <TextBlock Grid.Row="0" Text="Save Folder"
                   FontSize="13" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,6"/>
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="FolderPathBox"
                     FontSize="13" Padding="8,6" IsReadOnly="True"
                     BorderBrush="#B0B8C8" BorderThickness="1"
                     VerticalContentAlignment="Center"
                     Cursor="Hand" PreviewMouseLeftButtonUp="FolderPathBox_Click"/>
            <Button Grid.Column="1" Content="Browse…"
                    Width="76" Margin="8,0,0,0" Padding="0,6"
                    FontSize="13" BorderBrush="#B0B8C8"
                    Click="BrowseFolder_Click"/>
        </Grid>

        <!-- File Name -->
        <TextBlock Grid.Row="2" Text="Session File Name"
                   FontSize="13" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,6"/>
        <TextBox Grid.Row="3" x:Name="FileNameBox"
                 FontSize="14" Padding="8,6" Margin="0,0,0,18"
                 BorderBrush="#B0B8C8" BorderThickness="1"/>

        <!-- Countdown notice -->
        <TextBlock Grid.Row="4" x:Name="CountdownText"
                   FontSize="19" Foreground="#FF0000" HorizontalAlignment="Left"
                   Margin="0,0,0,4"/>

        <!-- Spacer -->
        <Grid Grid.Row="5"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="Cancel"
                    Width="90" Padding="0,8" Margin="0,0,12,0"
                    Click="CancelButton_Click"/>
            <Button x:Name="StartBtn" Content="▶  Start"
                    Width="110" Padding="0,8"
                    Background="#2E7D32" Foreground="White" FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="StartButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

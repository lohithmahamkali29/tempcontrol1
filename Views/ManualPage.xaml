<UserControl x:Class="TempControl.Views.ManualPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TempControl.ViewModels"
             xmlns:conv="clr-namespace:TempControl.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:ManualPageViewModel}"
             Background="#F0F2F5">

    <UserControl.Resources>
        <Style x:Key="DisplayTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="38"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A237E"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B0B8C8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="180"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
        <Style x:Key="EditableValueTextBox" TargetType="TextBox" BasedOn="{StaticResource DisplayTextBox}">
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Width" Value="180"/>
        </Style>
        <Style x:Key="FieldNameLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ZoneCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#DCE0E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="30,24"/>
            <Setter Property="Margin" Value="5 0"/>
        </Style>
        <Style x:Key="ZoneCardPV" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#DCE0E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="30,10"/>
            <Setter Property="Margin" Value="5 0"/>
        </Style>
        <Style x:Key="BottomBox" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#DCE0E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Margin" Value="10 10 10 150"/>
        </Style>
        <Style x:Key="RunButton" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                              BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#145214"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#A5A5A5"/>
                                <Setter Property="Foreground" Value="#D0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StopButton" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                              BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B71C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#7F0000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#A5A5A5"/>
                                <Setter Property="Foreground" Value="#D0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ManualOnButton" TargetType="Button" BasedOn="{StaticResource RunButton}">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="ManualOffButton" TargetType="Button" BasedOn="{StaticResource StopButton}">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style x:Key="EditButton" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0D47A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed"   Value="True">
                                <Setter Property="Background" Value="#082B70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"   Value="False">
                                <Setter Property="Background" Value="#A5A5A5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush"/>
        <Style x:Key="StatusEllipse" TargetType="Ellipse">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <Border Style="{StaticResource BottomBox}" HorizontalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0" Text="Manual Control"
                           FontSize="26" FontWeight="Bold" Foreground="#1A237E"
                           Margin="0,0,0,24" HorizontalAlignment="Center"/>

                <!-- Side-by-side: setpoints (left) | blowers/heaters (right) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left panel: setpoint + safety fields -->
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Zone 1 and 2 Temp Set Point" Style="{StaticResource FieldNameLabel}" Foreground="Green" Margin="0,0,30,18"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource EditableValueTextBox}" IsEnabled="{Binding IsEditMode}"
                                   Text="{Binding Zone1SetPointValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" Margin="0,0,0,18"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource UnitLabel}" Margin="0,0,0,18"><Run Text="&#x00B0;C"/></TextBlock>



                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Zone 1 Safety Temperature" Style="{StaticResource FieldNameLabel}" Foreground="Red" Margin="0,0,30,18"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource EditableValueTextBox}" IsEnabled="{Binding IsEditMode}"
                                   Text="{Binding Zone1SafetyTemperatureValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" Margin="0,0,0,18"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource UnitLabel}" Margin="0,0,0,18"><Run Text="&#x00B0;C"/></TextBlock>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Zone 2 Safety Temperature" Style="{StaticResource FieldNameLabel}" Foreground="Red" Margin="0,0,30,0"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource EditableValueTextBox}" IsEnabled="{Binding IsEditMode}"
                                   Text="{Binding Zone2SafetyTemperatureValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource UnitLabel}" Margin="0,0,0,18"><Run Text="&#x00B0;C"/></TextBlock>
                    </Grid>

                    <!-- Vertical divider -->
                    <Border Grid.Column="1" Width="1" Background="#DCE0E6" HorizontalAlignment="Center"/>

                    <!-- Right panel: blower/heater controls -->
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Blower-1" Style="{StaticResource FieldNameLabel}" Margin="0,0,30,18"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,18">
                                <Button Style="{StaticResource ManualOnButton}" Content="ON" Command="{Binding Blower1OnCommand}"
                                    IsEnabled="{Binding CanUseSupervisorControls}"/>
                                <Button Style="{StaticResource ManualOffButton}" Content="OFF" Command="{Binding Blower1OffCommand}"
                                    IsEnabled="{Binding CanUseSupervisorControls}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,18">
                            <Ellipse Style="{StaticResource StatusEllipse}" Fill="{Binding Blower1Status, Converter={StaticResource BoolToStatusBrush}}"/>
                            <TextBlock Text="Status" Foreground="#666" FontSize="20" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Blower-2" Style="{StaticResource FieldNameLabel}" Margin="0,0,30,18"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,18">
                                <Button Style="{StaticResource ManualOnButton}" Content="ON" Command="{Binding Blower2OnCommand}"
                                    IsEnabled="{Binding CanUseSupervisorControls}"/>
                                <Button Style="{StaticResource ManualOffButton}" Content="OFF" Command="{Binding Blower2OffCommand}"
                                    IsEnabled="{Binding CanUseSupervisorControls}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,18">
                            <Ellipse Style="{StaticResource StatusEllipse}" Fill="{Binding Blower2Status, Converter={StaticResource BoolToStatusBrush}}"/>
                            <TextBlock Text="Status" Foreground="#666" FontSize="20" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Heater-1" Style="{StaticResource FieldNameLabel}" Margin="0,0,30,18"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,18">
                                <Button Style="{StaticResource ManualOnButton}" Content="ON" Command="{Binding Heater1OnCommand}"
                                    IsEnabled="{Binding CanUseSupervisorControls}"/>
                                <Button Style="{StaticResource ManualOffButton}" Content="OFF" Command="{Binding Heater1OffCommand}"
                                    IsEnabled="{Binding CanUseSupervisorControls}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,18">
                            <Ellipse Style="{StaticResource StatusEllipse}" Fill="{Binding Heater1Status, Converter={StaticResource BoolToStatusBrush}}"/>
                            <TextBlock Text="Status" Foreground="#666" FontSize="20" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Heater-2" Style="{StaticResource FieldNameLabel}" Margin="0,0,30,0"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Style="{StaticResource ManualOnButton}" Content="ON" Command="{Binding Heater2OnCommand}"
                                    IsEnabled="{Binding CanUseSupervisorControls}"/>
                                <Button Style="{StaticResource ManualOffButton}" Content="OFF" Command="{Binding Heater2OffCommand}"
                                    IsEnabled="{Binding CanUseSupervisorControls}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,15">
                            <Ellipse Style="{StaticResource StatusEllipse}" Fill="{Binding Heater2Status, Converter={StaticResource BoolToStatusBrush}}"/>
                            <TextBlock Text="Status" Foreground="#666" FontSize="20" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Edit / Update buttons — centered below both panels -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button Style="{StaticResource EditButton}" Content="&#x270E;  Edit"
                            Command="{Binding EditCommand}"
                            IsEnabled="{Binding CanAttemptSupervisorEdit}"/>
                    <Button Style="{StaticResource RunButton}" Content="&#x2714;  Update"
                            Width="130" Height="48" FontSize="18"
                            Command="{Binding UpdateCommand}"
                            IsEnabled="{Binding IsEditMode}"/>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>

</UserControl>

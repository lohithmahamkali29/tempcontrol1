<UserControl x:Class="TempControl.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TempControl.ViewModels"
             xmlns:conv="clr-namespace:TempControl.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HomeViewModel}"
             Background="#F0F2F5">

    <UserControl.Resources>
        <Style x:Key="DisplayTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="38"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A237E"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B0B8C8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="180"/>
        </Style>
        <Style x:Key="DisplayTextBoxPV" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="55"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B0B8C8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="180"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
        <Style x:Key="UnitLabelPV" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <Style x:Key="ZoneCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#DCE0E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="30,24"/>
            <Setter Property="Margin" Value="5 0"/>
        </Style>
        <Style x:Key="ZoneCardPV" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#DCE0E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="30,10"/>
            <Setter Property="Margin" Value="5 0 0 0"/>
        </Style>
        <Style x:Key="BottomBox" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#DCE0E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Margin" Value="7"/>
        </Style>
        <Style x:Key="RunButton" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#145214"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#A5A5A5"/>
                                <Setter Property="Foreground" Value="#D0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StopButton" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B71C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#7F0000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#A5A5A5"/>
                                <Setter Property="Foreground" Value="#D0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush"/>
        <Style x:Key="AlarmDrawerButton" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="0.5*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ZoneCardPV}" MinWidth="550" HorizontalAlignment="Right">
                    <!-- DownOnly: the card renders at its natural size until a reading is
                         too wide for the card, then the whole block scales down uniformly
                         so every digit stays visible instead of being cut off. -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
                    <StackPanel VerticalAlignment="Top" Margin="0,12,0,0">
                        <Grid Margin="0,0,0,28">
                            <TextBlock Text="ZONE 1" FontSize="30" FontWeight="Bold"
                                       Foreground="#1A237E" HorizontalAlignment="Center"/>
                            <StackPanel HorizontalAlignment="Right" Margin="0,0,22,0">
                                <TextBlock Text="Safety" FontSize="22" FontWeight="SemiBold"
                                           Foreground="#1A237E" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding DataStore.ProcessZone1Safety, StringFormat={}{0:F1} °C, Mode=OneWay}"
                                          FontWeight="SemiBold" FontSize="20" Foreground=" #FFA500" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Columns size to their content so a long value keeps its full
                             width instead of overflowing a fixed half-card column. -->
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Labels row -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="PV" FontSize="25" FontWeight="Bold" Foreground="#1A237E"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="JOB TEMPARATURE" FontSize="25" FontWeight="Bold" Foreground="#1A237E"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>

                            <!-- TextBoxes row — both on same row so they align automatically -->
                            <Grid Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource DisplayTextBoxPV}"
                                         Text="{Binding DataStore.Zone1Temperature,StringFormat={}{0:F1}, Mode=OneWay }"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource UnitLabelPV}" Text="°C"/>
                            </Grid>

                            <Grid Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource DisplayTextBoxPV}" FontSize="38"
                                         MinWidth="0"
                                         Text="{Binding DataStore.Zone1Output, StringFormat={}{0:F1}, Mode=OneWay}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource UnitLabel}" Text="°C" Margin="4,0,0,0"/>
                            </Grid>

                        </Grid>
                    </StackPanel>
                    </Viewbox>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ZoneCardPV}" MinWidth="550" HorizontalAlignment="Left">
                    <!-- DownOnly: the card renders at its natural size until a reading is
                         too wide for the card, then the whole block scales down uniformly
                         so every digit stays visible instead of being cut off. -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
                    <StackPanel VerticalAlignment="Top" Margin="0,12,0,0">
                        <Grid Margin="0,0,0,28">
                            <TextBlock Text="ZONE 2" FontSize="30" FontWeight="Bold"
                                       Foreground="#1A237E" HorizontalAlignment="Center"/>
                            <StackPanel HorizontalAlignment="Right" Margin="0,0,22,0">
                                <TextBlock Text="Safety" FontSize="22" FontWeight="SemiBold"
                Foreground="#1A237E" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding DataStore.ProcessZone2Safety, StringFormat={}{0:F1} °C, Mode=OneWay}"
               FontWeight="SemiBold" FontSize="20" Foreground=" #FFA500" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Columns size to their content so a long value keeps its full
                             width instead of overflowing a fixed half-card column. -->
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Labels row -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="PV" FontSize="25" FontWeight="Bold" Foreground="#1A237E"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="JOB TEMPARATURE" FontSize="25" FontWeight="Bold" Foreground="#1A237E"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>

                            <!-- TextBoxes row — both on same row so they align automatically -->
                            <Grid Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource DisplayTextBoxPV}"
                                         Text="{Binding DataStore.Zone2Temperature, StringFormat={}{0:F1}, Mode=OneWay}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource UnitLabelPV}" Text="°C"/>
                            </Grid>

                            <Grid Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource DisplayTextBoxPV}" FontSize="38"
                                         MinWidth="0"
                                         Text="{Binding DataStore.Zone2Output, StringFormat={}{0:F1}, Mode=OneWay}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource UnitLabel}" Text="°C" Margin="4,0,0,0"/>
                            </Grid>

                        </Grid>
                    </StackPanel>
                    </Viewbox>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource BottomBox}">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="   SET  TEMPARATURE"
                                   FontSize="26" FontWeight="Bold" Foreground="#1A237E"
                                   HorizontalAlignment="Center" Margin="0,0,0,30"/>

                        <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource DisplayTextBox}" Foreground ="Green"
                                 Text="{Binding DataStore.Zone1Setpoint, StringFormat={}{0:F1}, Mode=OneWay}"/>

                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource UnitLabelPV}" HorizontalAlignment="Left" >
                            <Run Text="&#x00B0;C"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource BottomBox}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <TextBlock Text="TIMER" FontSize="26" FontWeight="Bold" Foreground="#1A237E"
                                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Set Time" FontSize="18" FontWeight="SemiBold" Foreground="#333"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource DisplayTextBox}" Foreground="Green"
                                             MinWidth="120"
                                             Text="{Binding DataStore.SoakTime, StringFormat=F0, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource UnitLabel}" Text="in Min" FontSize="20"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="20,0,0,0">
                                <TextBlock Text="Elp Time" FontSize="18" FontWeight="SemiBold" Foreground="#333"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource DisplayTextBox}"
                                             MinWidth="120"
                                             Text="{Binding DataStore.ElapsedTime, StringFormat=F0, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource UnitLabel}" Text="in Min" FontSize="20"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource BottomBox}">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="PROCESS STEP NUMBER"
                                   FontSize="26" FontWeight="Bold" Foreground ="#1A237E"
                                   HorizontalAlignment="Left" Margin="0,0,0,30" Height="35" VerticalAlignment="Bottom"/>

                        <TextBox Grid.Row="1" Style="{StaticResource DisplayTextBox}"
                                 Text="{Binding DataStore.CurrentProcessStepDisplay, Mode=OneWay}"/>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Running indicator — visible beside RUN button when process is active -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock FontSize="36" Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="🏃"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="RunnerBounce">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                        From="0" To="-10" Duration="0:0:0.35">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="RunnerBounce"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Running" Foreground="#2E7D32" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Style="{StaticResource RunButton}"
                        Command="{Binding RunCommand}"
                        IsEnabled="{Binding CanRun}"
                        Content="▶  RUN"
                        Margin="0,0,20,0"/>
                <Button Style="{StaticResource StopButton}"
                        Command="{Binding StopCommand}"
                        IsEnabled="{Binding CanStop}"
                        Content="■  STOP"
                        Margin="0,0,12,0"/>

                <!-- Stopped indicator — visible beside STOP button when process is idle -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="🧍" FontSize="36" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Stopped" Foreground="#666" FontSize="20" VerticalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="TempControl.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TempControl.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MenuViewModel}"
             Background="#F0F2F5">

    <UserControl.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#DCE0E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A237E"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Width" Value="90"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="FieldComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="190"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,6,20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ??? Report Download ??? -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}" Width="400">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Report Download"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="From Date:"/>
                        <DatePicker SelectedDate="{Binding ReportFromDate}" FontSize="13" Width="170"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="To Date:"/>
                        <DatePicker SelectedDate="{Binding ReportToDate}" FontSize="13" Width="170"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Save Path:"/>
                        <TextBox Style="{StaticResource FieldInput}" Width="170"
                                 Text="{Binding LogFilePath, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Zone:"/>
                        <ComboBox Style="{StaticResource FieldComboBox}" Width="170"
                                  ItemsSource="{Binding ReportZoneOptions}"
                                  SelectedItem="{Binding SelectedReportZone, Mode=TwoWay}"/>
                    </StackPanel>

                    <Button Style="{StaticResource ActionBtn}" Background="#1565C0" Content="Download CSV Report"
                            Command="{Binding DownloadReportCommand}" Margin="90,10,60,0"/>

                    <TextBlock Text="Report contains DateTime and the selected zone temperature only"
                               Foreground="#999" FontSize="11" FontStyle="Italic" Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Data Logging -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Data Logging"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse Width="10" Height="10" Fill="#43A047" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Logging is always active" Foreground="#43A047" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Logging starts when the application opens and cannot be stopped. Change the interval below."
                               Foreground="#999" FontSize="11" FontStyle="Italic" Margin="0,0,0,12"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Interval (s):"/>
                        <TextBox Style="{StaticResource FieldInput}" Width="80" FontFamily="Consolas"
                                 Text="{Binding LogIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Communication - per-slave status -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Communication"/>
                    <ItemsControl ItemsSource="{Binding DataStore.SlaveConfigs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F5F7FA" CornerRadius="6" Padding="12,10" Margin="0,3"
                                        BorderBrush="#E0E4EA" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Per-slave connection indicator -->
                                        <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#E53935"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                            <Setter Property="Fill" Value="#43A047"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="13" Foreground="#1565C0"
                                                   VerticalAlignment="Center">
                                            <Run Text="ID:"/><Run Text="{Binding SlaveId, Mode=OneWay}"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" Foreground="#222"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3" FontSize="12" Foreground="#1565C0" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Text="{Binding ConnectionType}"/>

                                        <TextBlock Grid.Column="4" FontSize="11" Foreground="#777" VerticalAlignment="Center"
                                                   Margin="0,0,12,0"
                                                   Text="{Binding ConnectionDetail, Mode=OneTime}"/>

                                        <TextBlock Grid.Column="5" FontSize="11" Foreground="#999" VerticalAlignment="Center"
                                                   Text="{Binding LastPollStatus}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ??? Status Message ??? -->
            <Border Grid.Row="2" Grid.ColumnSpan="2"
                    Background="White" CornerRadius="8" Padding="16,10" Margin="8,4"
                    BorderBrush="#DCE0E6" BorderThickness="1">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#388E3C" FontSize="13" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
